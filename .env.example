OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o
HF_SPACE_URL=https://your-space.hf.space
HF_TOKEN=hf_your-token-here
GUARDRAILS_ENABLED=true
MEMORY_WINDOW=10

# Judge / evaluator. Defaults to Claude (a different family than the GPT model under test)
# to avoid same-family evaluator bias. Set JUDGE_PROVIDER=openai to use OPENAI_JUDGE_MODEL.
JUDGE_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_JUDGE_MODEL=claude-sonnet-4-6

# Shared state — required only on stateless hosts (Vercel), where each request gets a fresh
# function instance with a read-only filesystem. Leave unset locally to keep in-process memory
# and logs/requests.jsonl. Vercel's Upstash integration injects these automatically; Upstash's
# own dashboard calls them UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN (also accepted).
KV_REST_API_URL=
KV_REST_API_TOKEN=